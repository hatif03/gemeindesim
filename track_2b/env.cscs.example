# Copy these lines into .env to run on the CSCS inference API instead of the hackathon gateway (research E20-E24, docs/research/07-cscs-vs-livemap.md).
# The key is personal: never commit .env.
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_FALLBACK_NAME=swiss-ai/Apertus-v1.5-8B
# No 429 up to 96 requests in flight was measured; 16 keeps a 25-resident town fast without hammering a shared service.
LLM_CONCURRENCY=16
# Optional: LLM_VOICE_NAME=swiss-ai/Apertus-v1.5-70B  (report and 1:1 chat) with LLM_NAME=swiss-ai/Apertus-v1.5-8B for the loop.
