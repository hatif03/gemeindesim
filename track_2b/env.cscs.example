# The CSCS inference API as the endpoint (research E20-E32, docs/ENDPOINTS.md). Copy these lines into .env; the key is personal, never commit .env.
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_API_KEY=
LLM_NAME=swiss-ai/Apertus-v1.5-70B
# LLM_CONCURRENCY defaults to auto (adaptive); the key was tested to 96 requests in flight without a 429.
# Optional: LLM_VOICE_NAME=swiss-ai/Apertus-v1.5-70B (report and chat) with LLM_NAME=swiss-ai/Apertus-v1.5-8B for the loop.
