# LLM (Hack Apertus organizer names)
LLM_NAME=apertus-v1.5-70b
LLM_BASE_URL=https://hackapertus.livemap.sh/v1
LLM_API_KEY=your-hackathon-key-here

# Optional: two-phase NPC rounds (code-side initiator scoring)
# SWARM=true

# Optional: max concurrent completions against the gateway
# LLM_CONCURRENCY=6

# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend — set at build time for Next.js
# NEXT_PUBLIC_API_URL=http://localhost:8000
