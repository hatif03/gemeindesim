# Hack Apertus / GemeindeSim — copy to .env (never commit .env)

# Required by submission template (names must match for judges)
LLM_NAME=apertus-v1.5-70b
LLM_BASE_URL=https://hackapertus.livemap.sh/v1
LLM_API_KEY=

# Optional
# LLM_NAME=apertus-v1.5-8b
# LLM_CONCURRENCY=4   # the hosted gateway returns 429 above ~4 requests in flight
# LLM_VOICE_NAME=   # optional: a different model for the report and the 1:1 chat (e.g. the 70B while the loop runs the 8B)
# LLM_FALLBACK_NAME=apertus-v1.5-8b   # used only after a timeout / 5xx of the main model
# CSCS inference API instead of the hackathon gateway: see env.cscs.example
# SWARM=false   # true = two-phase initiator/reactor rounds (supported, measured: +27 % time on the 70B, no gain)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# UI_ALT_PORT=8080   # second published UI port; change it if 8080 is already in use
# LOG_LEVEL=INFO
