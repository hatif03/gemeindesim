# Hack Apertus / GemeindeSim — copy to .env (never commit .env)
# The same build runs on both inference endpoints; docs/ENDPOINTS.md explains what the app does for each.

# Required by the submission template (names must match for judges)
# CSCS inference API (judging):
LLM_BASE_URL=https://api.inference.cscs.ch/v1
LLM_NAME=swiss-ai/Apertus-v1.5-70B
LLM_API_KEY=
# Hackathon gateway (livemap) instead:
# LLM_BASE_URL=https://hackapertus.livemap.sh/v1
# LLM_NAME=apertus-v1.5-70b      (either id style is accepted on either endpoint: the app maps it)

# Optional
# LLM_CONCURRENCY=auto   # default: adapts (starts at 4, doubles on a clean streak, halves on 429 / timeout, backs off if latency per token doubles); a number fixes it
# LLM_CONCURRENCY_MAX=32
# LLM_VOICE_NAME=   # a different model for the report and the 1:1 chat (e.g. the 70B while the loop runs the 8B)
# LLM_FALLBACK_NAME=   # used only after a timeout / 5xx of the main model; default: the 8B that goes with LLM_NAME
# CHAT_STREAM=1   # chat answers arrive sentence by sentence (each checked first); 0 = one message
# CHAT_STUFF_MAX_CHARS=100000   # documents up to this size go into the chat prompt whole; 0 = retrieval only
# EMBEDDING_MODEL=   # e.g. intfloat/multilingual-e5-large (+ pip install fastembed): hybrid BM25 + dense retrieval, research E30
# SWARM=false   # true = two-phase initiator/reactor rounds (supported, measured: +27 % time on the 70B, no gain)
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# UI_ALT_PORT=8080   # second published UI port; change it if 8080 is already in use
# LOG_LEVEL=INFO
